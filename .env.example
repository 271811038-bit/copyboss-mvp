# 复制本文件为 .env.local，然后填上真实值
# .env.local 不会被 git 跟踪（.gitignore 已配置）

# 数据库连接字符串
# 本地开发（SQLite）：DATABASE_URL="file:./dev.db"
# 生产（Postgres）：DATABASE_URL="postgresql://user:pass@host:5432/dbname"
DATABASE_URL=""

# NextAuth 密钥（必须！用 openssl rand -base64 32 生成）
AUTH_SECRET=""
NEXTAUTH_SECRET=""

# 应用 URL
NEXTAUTH_URL="http://localhost:3000"
AUTH_TRUST_HOST="true"

# DeepSeek API key（https://platform.deepseek.com 申请）
DEEPSEEK_API_KEY=""