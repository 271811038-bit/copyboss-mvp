# ============================================================
# CopyBoss 环境变量模板
# 复制本文件为 .env.local，然后填上真实值
# .env.local 不会被 git 跟踪（.gitignore 已配置）
#
# 数据库分两套：
#   本地开发（SQLite）：用 file:./dev.db
#   生产（Vercel Postgres）：Vercel 会自动注入 DATABASE_URL
# ============================================================

# ===== 本地开发：SQLite =====
# 终端跑：npm run dev 时用这个
DATABASE_URL="file:./dev.db"

# ===== 生产：Postgres =====
# 部署到 Vercel 时，Vercel 会自动注入 postgresql:// 开头的 URL
# 不用手填，Vercel 会帮你写进环境变量
# 本地想测 Postgres 时填：DATABASE_URL="postgresql://user:pass@localhost:5432/copyboss"

# ===== NextAuth 认证 =====
# 用 openssl rand -base64 32 生成
AUTH_SECRET=""
NEXTAUTH_SECRET=""

# ===== 应用 URL =====
# 本地：http://localhost:3000
# 生产：https://你的域名.vercel.app
NEXTAUTH_URL="http://localhost:3000"
AUTH_TRUST_HOST="true"

# ===== DeepSeek API key =====
# 申请地址：https://platform.deepseek.com
DEEPSEEK_API_KEY=""

# ===== Lemon Squeezy 订阅付费 =====
# 申请地址：https://app.lemonsqueezy.com 注册商家 → 创建产品 → 拿到下面两个值
# 1. CHECKOUT_URL：产品 checkout 链接（https://xxx.lemonsqueezy.com/buy/xxx）
#    留空 = 定价页显示"支付通道即将上线"，页面不炸
LEMONSQUEEZY_CHECKOUT_URL=""
# 2. WEBHOOK_SECRET：Settings → Webhooks → 新建 webhook（Signing secret）
#    回调地址填：https://你的域名/api/webhooks/lemonsqueezy
#    勾选事件：subscription_created / updated / cancelled / expired / payment_failed
LEMONSQUEEZY_WEBHOOK_SECRET=""
