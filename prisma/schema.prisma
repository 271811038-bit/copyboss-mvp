// ============================================================
// CopyBoss 生产环境 schema（PostgreSQL）
// 本地用 schema.sqlite.prisma 这份
//
// Prisma 5.x 不支持 provider 用 env() 动态切换，所以维护两份 schema
// package.json 的 dev/db:push 脚本指定 sqlite 版本
// package.json 的 build/db:migrate 脚本指定 postgresql 版本（默认）
// ============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// User 表 = 所有注册过的用户
model User {
  id             String   @id @default(cuid())
  email          String   @unique
  name           String?
  hashedPassword String
  createdAt      DateTime @default(now())

  // ===== 订阅相关（Lemon Squeezy）=====
  plan                 String   @default("FREE") // FREE | PRO
  lsCustomerId         String?  // Lemon Squeezy 的 customer id
  lsSubscriptionId     String?  @unique // 订阅 id（一个订阅只对应一个用户）
  lsSubscriptionStatus String?  // active / cancelled / expired / past_due / unpaid

  copies         Copy[]       // 一个用户的所有文案（一对多）
  generations    Generation[] // 一个用户的所有生成请求日志（一对多）
}

// Copy 表 = 每一条生成出来的文案
model Copy {
  id         String   @id @default(cuid())
  userId     String
  platform   String
  style      String
  content    String   @db.Text  // Postgres 用 @db.Text 避免 varchar(255) 截断
  isFavorite Boolean  @default(false)
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

// Generation 表 = 每一次"生成请求"的日志
model Generation {
  id        String   @id @default(cuid())
  userId    String
  platforms String
  styles    String
  product   String   @db.Text
  copyCount Int
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}
