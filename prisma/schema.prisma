// CopyBoss 数据库蓝图（schema）
// 每一行 model = 数据库里的一张表
// 当前阶段只建 User 表；之后会加 Copy / Product / Subscription

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  // SQLite 本地文件：prisma/dev.db
  // 上线生产时换成 Postgres，只需改 provider 和 DATABASE_URL
  url      = env("DATABASE_URL")
}

// User 表 = 所有注册过的用户
// @id          主键（每条记录的唯一身份证）
// @default(cuid()) 自动生成一段不重复的随机 ID
// @unique       email 不能重复（两个用户不能用同一个邮箱注册）
// hashedPassword 不是明文密码，是加密后的"乱码"（更安全）
// createdAt     注册时间，自动填当前时间
model User {
  id             String   @id @default(cuid())
  email          String   @unique
  name           String?
  hashedPassword String
  createdAt      DateTime @default(now())
  copies         Copy[]   // 一个用户的所有文案（一对多）
}

// Copy 表 = 每一条生成出来的文案
// userId  谁生成的（外键，关联到 User 表）
// 平台/风格/内容  文案本身的三要素
// createdAt 什么时候生成的（历史页按时间倒序排）
// isFavorite 是否收藏（收藏功能用，红心❤️）
model Copy {
  id         String   @id @default(cuid())
  userId     String
  platform   String   // 小红书 / 公众号 / 抖音文案
  style      String   // 亲切口语 / 专业干货 / 犀利促销 …
  content    String   // 文案正文
  isFavorite Boolean  @default(false)
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  // 复合索引：按 userId+createdAt 排序查询更快（历史页的核心查询）
  @@index([userId, createdAt])
}