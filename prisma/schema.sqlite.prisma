// ============================================================
// CopyBoss 本地开发 schema（SQLite）
// 生产用 schema.prisma（PostgreSQL）
//
// Prisma 5.x 不支持 provider 动态切换，所以维护两份
// 切换方式：
//   开发：npm run dev          （自动用 sqlite）
//   生产：npm run build        （自动用 postgresql）
// ============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// User 表 = 所有注册过的用户
model User {
  id             String   @id @default(cuid())
  email          String   @unique
  name           String?
  hashedPassword String
  createdAt      DateTime @default(now())

  // ===== 订阅相关（Lemon Squeezy）=====
  plan                 String   @default("FREE") // FREE | PRO
  lsCustomerId         String?  // Lemon Squeezy 的 customer id
  lsSubscriptionId     String?  @unique // 订阅 id（一个订阅只对应一个用户）
  lsSubscriptionStatus String?  // active / cancelled / expired / past_due / unpaid

  copies         Copy[]
  generations    Generation[]
}

// Copy 表 = 每一条生成出来的文案
model Copy {
  id         String   @id @default(cuid())
  userId     String
  platform   String
  style      String
  content    String   // SQLite 无 varchar 限制
  isFavorite Boolean  @default(false)
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

// Generation 表 = 每一次"生成请求"的日志
model Generation {
  id        String   @id @default(cuid())
  userId    String
  platforms String
  styles    String
  product   String
  copyCount Int
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}
